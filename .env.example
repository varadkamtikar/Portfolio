# Bank Note demo: base URL of the deployed FastAPI service (leave blank until deployed; the demo then shows an "unavailable" state)
BANKNOTE_API_URL=

# Chat (/api/chat). Default provider: any OpenAI-compatible API, e.g. Groq's free tier.
LLM_PROVIDER=openai            # "openai" (OpenAI-compatible) or "anthropic"
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                   # never commit; set in Vercel project settings
CHAT_MODEL=openai/gpt-oss-120b # verify the current model id on your provider
# Only when LLM_PROVIDER=anthropic (CHAT_MODEL defaults to claude-haiku-5-5):
ANTHROPIC_API_KEY=
