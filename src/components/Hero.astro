---
import { Image } from 'astro:assets';
import photo from '../assets/profile-photo.png';
import profile from '../../content/profile.json';
---
<section id="top" class="hero wrap">
  <p class="badge mono"><span class="dot" aria-hidden="true"></span>{profile.availableLabel}</p>
  <h1>{profile.name}</h1>
  <p class="tagline">{profile.tagline}</p>
  <canvas data-waveform data-amp="0.35" class="wave" role="img" aria-label="Animated EEG-style waveform"></canvas>
  <div class="ctas">
    <a class="btn btn-primary" href="#projects">View work</a>
    <a class="btn" href="#ask">Ask my portfolio</a>
    <a class="btn" href={profile.cv.file} download>Download CV</a>
  </div>
  <Image class="photo" src={photo} alt="Portrait of Varadkrishna Kamtikar" width={220} height={220} loading="eager" />
</section>
<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 1.5rem; padding-top: 7rem; padding-bottom: 3rem; }
  h1 { font-size: var(--step-5); overflow-wrap: anywhere; }
  .tagline { font-size: var(--step-1); max-width: 34ch; color: var(--muted); margin: 0; }
  .badge { display: inline-flex; align-items: center; gap: 0.6rem; margin: 0; color: var(--muted); }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--accent); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); } 100% { box-shadow: 0 0 0 12px transparent; } }
  .wave { width: 100%; height: 140px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .photo { position: absolute; right: var(--gutter); top: 8rem; width: clamp(110px, 16vw, 220px); height: auto; border-radius: 4px; filter: grayscale(0.4); }
  @media (max-width: 700px) { .photo { position: static; width: 110px; } }
</style>
