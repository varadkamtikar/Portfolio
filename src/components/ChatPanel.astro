---
import profile from '../../content/profile.json';
---
<dialog id="chat" aria-labelledby="chat-title">
  <header>
    <div>
      <h2 id="chat-title">Ask my portfolio</h2>
      <p class="mono sub">AI answers from this site's content</p>
    </div>
    <button type="button" class="close" data-chat-close aria-label="Close chat">✕</button>
  </header>

  <div id="chat-log" role="log" aria-live="polite" aria-label="Conversation" data-lenis-prevent tabindex="0">
    <div class="msg bot"><p>Hi! Ask me about Varad's projects, experience, skills or education.</p></div>
  </div>

  <ul id="chat-chips" class="chips" aria-label="Suggested questions">
    {profile.chatSuggestions.map((q) => <li><button type="button" class="chip" data-suggest={q}>{q}</button></li>)}
  </ul>

  <form id="chat-form" autocomplete="off">
    <label for="chat-input" class="sr">Your question</label>
    <textarea id="chat-input" rows="2" maxlength="500" placeholder="Ask a question…"></textarea>
    <button type="submit" class="btn btn-primary" id="chat-send">Send</button>
    <p class="mono note"><span id="chat-count">0</span>/500 · Questions are sent to an AI provider, so please don't include personal information. Answers may be wrong.</p>
  </form>
</dialog>

<style is:global>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  #chat { margin: 0 0 0 auto; padding: 0; width: min(440px, 100vw); max-width: 100vw; height: 100dvh; max-height: none; border: 0; border-left: 1px solid var(--line); background: var(--bg); color: var(--ink); }
  #chat[open] { display: flex; flex-direction: column; animation: chat-in .3s ease-out; }
  #chat::backdrop { background: rgb(0 0 0 / 0.55); }
  @keyframes chat-in { from { transform: translateX(100%); } to { transform: none; } }
  #chat header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1.1rem 1.25rem; border-bottom: 1px solid var(--line); }
  #chat h2 { font-size: var(--step-2); }
  #chat .sub { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.72rem; }
  #chat .close { background: none; border: 1px solid var(--line); color: var(--ink); width: 2.4rem; height: 2.4rem; border-radius: 50%; cursor: pointer; }
  #chat-log { flex: 1; overflow-y: auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .msg { max-width: 92%; padding: 0.7rem 0.95rem; border-radius: 10px; line-height: 1.5; overflow-wrap: anywhere; }
  .msg p { margin: 0 0 0.6rem; } .msg p:last-child { margin: 0; }
  .msg ul { margin: 0 0 0.6rem; padding-left: 1.1rem; }
  .msg a { color: var(--accent); }
  .msg code { font-family: var(--font-mono); font-size: 0.88em; }
  .msg.bot { background: var(--bg-2); border: 1px solid var(--line); align-self: flex-start; }
  .msg.user { background: var(--accent); color: var(--accent-ink); align-self: flex-end; }
  .msg.err { border-color: #e5484d; }
  .msg .retry { margin-top: 0.6rem; }
  .srcs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.7rem; padding: 0; list-style: none; }
  .srcs a { display: inline-block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 0.15rem 0.65rem; color: var(--ink); }
  .srcs a:hover { border-color: var(--accent); }
  .typing { display: inline-flex; gap: 4px; padding: 0.35rem 0; }
  .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: blink 1.2s infinite; }
  .typing i:nth-child(2) { animation-delay: .2s; } .typing i:nth-child(3) { animation-delay: .4s; }
  @keyframes blink { 0%, 80%, 100% { opacity: .25; } 40% { opacity: 1; } }
  #chat .chips { list-style: none; display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0; padding: 0 1.25rem 0.75rem; }
  .chip { font: inherit; font-size: var(--step--1); background: none; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; cursor: pointer; text-align: left; }
  .chip:hover { border-color: var(--accent); }
  #chat-form { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem; padding: 0.9rem 1.25rem 1.1rem; border-top: 1px solid var(--line); }
  #chat-input { resize: none; background: var(--bg-2); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.8rem; font: inherit; }
  #chat-form .note { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: 0.68rem; text-transform: none; letter-spacing: 0; }
  #chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
