---
import SectionHead from './SectionHead.astro';
import skills from '../../content/skills.json';
---
<section id="skills" class="wrap sec">
  <SectionHead index="04" title="Skills" />
  <div class="groups">
    {skills.map((g) => (
      <div>
        <h3 class="mono">{g.category}</h3>
        <ul>{g.skills.map((s) => <li><button type="button" data-skill={s}>{s}</button></li>)}</ul>
      </div>
    ))}
  </div>
</section>
<style>
  .groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2.5rem; }
  h3 { font-family: var(--font-mono); font-size: var(--step--1); color: var(--accent); margin-bottom: 1rem; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  button { font: inherit; font-size: var(--step--1); background: none; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.9rem; cursor: pointer; }
  button:hover { border-color: var(--accent); }
</style>
