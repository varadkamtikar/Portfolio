---
import { hasCv } from '../lib/site';
import profile from '../../content/profile.json';
const base = Astro.url.pathname === '/' ? '' : '/';
const links = [['About', '#about'], ['Experience', '#experience'], ['Projects', '#projects'], ['Skills', '#skills'], ['Contact', '#contact']];
---
<nav class="nav" aria-label="Primary">
  <a href={`${base}#top`} class="logo" aria-label="VK, Varad Kamtikar home">VK</a>
  <ul data-nav>
    {links.map(([l, h]) => <li><a href={`${base}${h}`}>{l}</a></li>)}
  </ul>
  <div class="right">
    <button class="kbd mono" data-palette-open aria-label="⌘K, open command palette">⌘K</button>
    <button class="menu-btn icon-btn" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu"><span aria-hidden="true">☰</span></button>
    <button class="icon-btn" data-theme-toggle aria-pressed="false" aria-label="Toggle light theme">◐</button>
    {hasCv && <a class="btn" href={profile.cv.file} download>Download CV</a>}
  </div>
</nav>
<div id="mobile-menu" class="mobile-menu" hidden>
  <ul>
    {links.map(([l, h]) => <li><a href={`${base}${h}`}>{l}</a></li>)}
    {hasCv && <li><a href={profile.cv.file} download>Download CV</a></li>}
  </ul>
</div>
<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem var(--gutter); background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .logo { font-family: var(--font-display); font-size: 1.5rem; text-decoration: none; border: 1px solid var(--ink); border-radius: 50%; width: 2.6rem; height: 2.6rem; display: grid; place-items: center; }
  ul[data-nav] { display: flex; gap: 1.75rem; list-style: none; margin: 0; padding: 0; }
  ul[data-nav] a { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; color: var(--muted); }
  ul[data-nav] a:hover, ul[data-nav] a[aria-current] { color: var(--ink); }
  ul[data-nav] a[aria-current] { border-bottom: 1px solid var(--accent); }
  .right { display: flex; align-items: center; gap: 0.75rem; }
  .kbd { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 6px; padding: 0.35rem 0.6rem; cursor: pointer; }
  .kbd:hover { color: var(--ink); border-color: var(--accent); }
  .icon-btn { background: none; border: 1px solid var(--line); color: var(--ink); width: 2.6rem; height: 2.6rem; border-radius: 50%; cursor: pointer; font-size: 1.1rem; }
  .menu-btn { display: none; }
  .mobile-menu { position: fixed; inset: 4.5rem 0 auto 0; z-index: 49; background: var(--bg); border-bottom: 1px solid var(--line); padding: 0.5rem var(--gutter) 1rem; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .mobile-menu a { display: block; padding: 0.95rem 0; border-bottom: 1px solid var(--line); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; color: var(--ink); }
  @media (max-width: 860px) { ul[data-nav], .kbd { display: none; } .menu-btn { display: inline-block; } }
  @media (max-width: 560px) { .right > .btn { display: none; } }
</style>
