---
import profile from '../../content/profile.json';
---
<footer class="wrap foot">
  <canvas data-waveform data-amp="0.3" class="wave" aria-hidden="true"></canvas>
  <p class="mono">Last updated {profile.lastUpdated} · Built with Astro, GSAP &amp; Tailwind</p>
</footer>
<style>
  .foot { padding-block: 3rem; color: var(--muted); }
  .wave { width: 100%; height: 60px; }
</style>
