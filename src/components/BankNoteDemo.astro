---
// Ranges come from the min/max of the repo's BankNote_Authentication.csv; presets are real rows (class 0 = authentic, 1 = fake).
const features = [
  { id: 'variance', min: -7.04, max: 6.83, v: 3.6216 },
  { id: 'skewness', min: -13.78, max: 12.96, v: 8.6661 },
  { id: 'curtosis', min: -5.29, max: 17.93, v: -2.8073 },
  { id: 'entropy', min: -8.55, max: 2.45, v: -0.44699 },
];
---
<section class="demo" id="demo" aria-labelledby="demo-h">
  <div class="top"><h2 id="demo-h">Try the model</h2><span class="tag mono">Demo</span></div>
  <p class="note">Move the sliders to send the four wavelet features to the FastAPI <code>/predict</code> endpoint.</p>
  <div class="presets">
    <button type="button" class="btn" data-preset="3.6216,8.6661,-2.8073,-0.44699">Row from dataset: class 0</button>
    <button type="button" class="btn" data-preset="-2.5419,-0.65804,2.6842,1.1952">Row from dataset: class 1</button>
  </div>
  <div class="sliders">
    {features.map((f) => (
      <label>
        <span class="mono">{f.id}</span>
        <input type="range" id={f.id} min={f.min} max={f.max} step="0.01" value={f.v} />
        <output for={f.id} class="mono">{f.v}</output>
      </label>
    ))}
  </div>
  <p id="demo-result" class="result" role="status" aria-live="polite">Pick a preset or move a slider to run the model.</p>
</section>
<style>
  .demo { border: 1px solid var(--line); background: var(--bg-2); border-radius: 8px; padding: 1.75rem; }
  .top { display: flex; align-items: center; gap: 1rem; }
  h2 { font-size: var(--step-2); }
  .tag { border: 1px solid var(--accent); color: var(--accent); border-radius: 999px; padding: 0.1rem 0.7rem; }
  .note { color: var(--muted); }
  code { font-family: var(--font-mono); font-size: 0.9em; }
  .presets { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .sliders { display: grid; gap: 1rem; }
  label { display: grid; grid-template-columns: 6rem 1fr 5rem; align-items: center; gap: 1rem; }
  input[type='range'] { accent-color: var(--accent); width: 100%; }
  output { text-align: right; color: var(--muted); }
  .result { margin: 1.5rem 0 0; font-family: var(--font-display); font-size: var(--step-2); }
  .result.err { font-family: var(--font-body); font-size: var(--step-0); color: var(--muted); }
  @media (max-width: 600px) { label { grid-template-columns: 1fr 5rem; } label input { grid-column: 1 / -1; grid-row: 2; } }
</style>
<script>
  const ids = ['variance', 'skewness', 'curtosis', 'entropy'];
  const el = (id: string) => document.getElementById(id) as HTMLInputElement;
  const res = document.getElementById('demo-result')!;
  let timer: number, ctl: AbortController | undefined;

  const run = async () => {
    ctl?.abort(); ctl = new AbortController();
    const body = Object.fromEntries(ids.map((i) => [i, Number(el(i).value)]));
    ids.forEach((i) => ((document.querySelector(`output[for=${i}]`) as HTMLElement).textContent = el(i).value));
    try {
      const r = await fetch('/api/banknote', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), signal: ctl.signal });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.prediction) throw new Error(j.error ?? 'unavailable');
      res.className = 'result'; res.textContent = j.prediction;
    } catch (e) {
      if ((e as Error).name === 'AbortError') return;
      res.className = 'result err';
      res.textContent = 'The demo endpoint is not live right now. The model itself is in the GitHub repo.';
    }
  };
  ids.forEach((i) => el(i).addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 250); }));
  document.querySelectorAll<HTMLElement>('[data-preset]').forEach((b) =>
    b.addEventListener('click', () => { b.dataset.preset!.split(',').forEach((v, k) => (el(ids[k]).value = v)); run(); }));
</script>
