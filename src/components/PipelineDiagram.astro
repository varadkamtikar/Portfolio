---
const { steps } = Astro.props as { steps: string[] };
const W = 190, H = 64, GAP = 44;
const width = steps.length * W + (steps.length - 1) * GAP;
const lines = (t: string) => {
  const words = t.split(' '); const out: string[] = []; let cur = '';
  for (const w of words) { if ((cur + ' ' + w).trim().length > 19) { out.push(cur); cur = w; } else cur = (cur + ' ' + w).trim(); }
  out.push(cur); return out.slice(0, 3);
};
---
<figure class="pipe">
  <div class="scroll">
    <svg viewBox={`0 0 ${width} ${H + 4}`} width={width} role="img" aria-label={`Pipeline: ${steps.join(' then ')}`}>
      {steps.map((s, i) => {
        const x = i * (W + GAP), ls = lines(s);
        return (
          <g>
            <rect x={x + 1} y="2" width={W - 2} height={H} rx="6" class="node" />
            {ls.map((l, j) => <text x={x + W / 2} y={2 + H / 2 + (j - (ls.length - 1) / 2) * 16 + 4} text-anchor="middle" class="lbl">{l}</text>)}
            {i < steps.length - 1 && <path d={`M${x + W + 6} ${H / 2 + 2} H${x + W + GAP - 8} m-6 -5 l6 5 l-6 5`} class="arrow" />}
          </g>
        );
      })}
    </svg>
  </div>
</figure>
<style>
  .pipe { margin: 0; }
  .scroll { overflow-x: auto; padding-bottom: 0.5rem; }
  svg { display: block; max-width: none; height: auto; }
  .node { fill: var(--bg-2); stroke: var(--line); }
  .lbl { fill: var(--ink); font-family: var(--font-mono); font-size: 12.5px; }
  .arrow { fill: none; stroke: var(--accent); stroke-width: 1.5; }
</style>
