---
import SectionHead from './SectionHead.astro';
import profile from '../../content/profile.json';
import edu from '../../content/education.json';
---
<section id="about" class="wrap sec">
  <SectionHead index="01" title="About" />
  <div class="grid">
    <p class="lead">{profile.about[0]}</p>
    <div class="side">
      <p>{profile.about[1]}</p>
      <p>{profile.about[2]}</p>
      <h3 class="mono">Education</h3>
      <ul>
        {edu.map((e) => <li><strong>{e.degree}</strong><br />{e.school}, {e.place} <span class="mono">{e.years}</span>{e.grade && <><br /><span class="muted">{e.grade}</span></>}</li>)}
      </ul>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 6vw, 6rem); }
  .lead { font-family: var(--font-display); font-size: var(--step-3); line-height: 1.15; margin: 0; }
  .side { padding-top: 0.75rem; color: var(--muted); }
  .side h3 { font-family: var(--font-mono); font-size: var(--step--1); margin-top: 2rem; color: var(--accent); }
  ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
  strong { color: var(--ink); font-weight: 500; }
  .muted { color: var(--muted); }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
</style>
